// ─────────────────────────────────────────────────────────────────────────────
// DEV — Debug Build Configuration
// Dart entry-point: lib/main_dev.dart
// Bundle ID:        com.antigravity.expenseManagerApp.dev
// App display name: Personal Expense (Dev)
// ─────────────────────────────────────────────────────────────────────────────

// Include the base Flutter Debug configuration
#include "Debug.xcconfig"

// Override build settings for the dev flavor
FLUTTER_TARGET = lib/main_dev.dart
BUNDLE_ID_SUFFIX = .dev
APP_DISPLAY_NAME = Personal Expense (Dev)
PRODUCT_BUNDLE_IDENTIFIER = com.antigravity.expenseManagerApp$(BUNDLE_ID_SUFFIX)
